
<section class="shop-section">
  <div class="section-heading">
    <span class="eyebrow">DKOSMETICS BEAUTY</span>
    <h1>Search Results</h1>
    <p>Find your favourite beauty essentials.</p>
  </div>

  <%= render "products/search_form" %>

  <p class="search-summary">
    <%= pluralize(@products.size, "product") %> found

    <% if @keyword.present? %>
      for "<%= @keyword %>"
    <% end %>
  </p>

  <% if @products.any? %>
    <div class="product-grid">
      <% @products.each do |product| %>
        <article class="product-card">
          <div class="product-image-placeholder">
            <% if product.image.attached? %>
              <%= image_tag product.image,
                  alt: product.name,
                  style: "width: 100%; height: 100%; object-fit: cover;" %>
            <% else %>
              <span>DK</span>
              <small>DKOSMETICS</small>
            <% end %>
          </div>

          <div class="product-info">
            <span class="product-category">
              <%= product.category.name %>
            </span>

            <h3><%= product.name %></h3>

            <p><%= truncate(product.description, length: 90) %></p>

            <div class="product-bottom">
              <strong class="product-price">
                <%= number_to_currency(product.price) %>
              </strong>

              <%= link_to "View Product",
                  product_path(product),
                  class: "view-product-button" %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="no-results">
      <h2>No products found</h2>
      <p>Try a different keyword or category.</p>
      <%= link_to "Back to Shop",
          root_path,
          class: "view-product-button" %>
    </div>
  <% end %>
</section>
