
<div class="storefront">
  <section class="hero">
    <div class="hero-content">
      <span class="eyebrow">WELCOME TO DKOSMETICS</span>
      <h1>Beauty Begins With You.</h1>
      <p>
        Discover your glow with our collection of
        lip glosses, lip liners, lashes and beauty essentials.
      </p>
      <a href="#shop" class="shop-button">Shop Collection</a>
    </div>
  </section>

  <section id="shop" class="shop-section">
    <%= render "products/search_form" %>

    <div class="section-heading">
      <span class="eyebrow">THE BEAUTY EDIT</span>
      <h2>Shop Our Collection</h2>
      <p>Little luxuries for your everyday glow.</p>
    </div>

    <div class="product-grid">
      <%= render @products %>
    </div>
  </section>

  <section class="shop-section" id="categories">
    <div class="section-heading">
      <span class="eyebrow">EXPLORE DKOSMETICS</span>
      <h2>Shop by Category</h2>
      <p>Find your favourite beauty essentials.</p>
    </div>

    <div class="category-grid">
      <% @categories.each do |category| %>
        <%= link_to category_path(category), class: "category-card" do %>
          <div class="category-card-content">
            <h3><%= category.name %></h3>

            <p><%= category.products.count %> Products</p>

            <span class="category-shop-button">
              Shop Collection &rarr;
            </span>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
</div>
