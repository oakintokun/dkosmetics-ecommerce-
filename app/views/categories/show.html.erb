
<section class="shop-section">
  <div class="section-heading">
    <span class="eyebrow">DKOSMETICS COLLECTION</span>

    <h1><%= @category.name %></h1>

    <p><%= @category.description %></p>

    <%= link_to "All Categories",
        categories_path,
        class: "site-page-button" %>
  </div>

  <div class="product-grid">
    <%= render @products %>
  </div>
</section>

